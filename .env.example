# Waitlist emails (app/api/subscribe)
RESEND_API_KEY=re_xxxxx

# Contact form - Formspree (no domain verification). Get from https://formspree.io
FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Unsubscribe system - Upstash Redis (@upstash/redis)
# REQUIRED: Get these from Upstash Console (https://console.upstash.com/) or Vercel Marketplace
# URL should point to your real database, e.g. https://vocal-griffon-45634.upstash.io
# If local writes don't persist to Upstash dashboard, your URL may be wrong or pointing to a mock
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE_ID.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Legacy fallback (Vercel KV / old integrations) - @upstash/redis also reads these
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: for logo URL in emails (default: https://paymentrecovery.io)
NEXT_PUBLIC_SITE_URL=https://paymentrecovery.io

# If your app is served from a subpath (e.g. /waitlist), set this so unsubscribe links work
# NEXT_PUBLIC_BASE_PATH=/waitlist

# Optional: physical address for email footer (required for CAN-SPAM compliance)
MAILING_ADDRESS=PaymentRecovery Inc., 123 Business Ave, San Francisco, CA 94102, USA
